{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/layout/**",
              "components/navigation/**",
              "image-slot.js",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:League Spartan|Comfortaa|Josefin Sans))/i]",
        "message": "Font not provided by the design system. Available: League Spartan, Comfortaa, Josefin Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, size, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:brand|neutral|outline|dark|verde)$/]",
        "message": "<Badge> variant must be one of 'brand' | 'neutral' | 'outline' | 'dark' | 'verde'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|fullWidth|href|onClick|type|icon|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, fullWidth, href, onClick, type, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalloutBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|cta|ctaSecondary|onCta|onCtaSecondary|variant|align|size|style|key|ref|className|style|children)$/]",
        "message": "<CalloutBanner> doesn't accept that prop. Declared props: eyebrow, title, description, cta, ctaSecondary, onCta, onCtaSecondary, variant, align, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalloutBanner'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:brand|dark|light|outline)$/]",
        "message": "<CalloutBanner> variant must be one of 'brand' | 'dark' | 'light' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalloutBanner'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<CalloutBanner> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalloutBanner'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CalloutBanner> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|padding|onClick|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, padding, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|bordered|elevated|flat|brand|dark)$/]",
        "message": "<Card> variant must be one of 'default' | 'bordered' | 'elevated' | 'flat' | 'brand' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sector|metric|metricLabel|description|tags|onClick|key|ref|className|style|children)$/]",
        "message": "<CaseStudyCard> doesn't accept that prop. Declared props: title, sector, metric, metricLabel, description, tags, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|tag|variant|layout|style|key|ref|className|style|children)$/]",
        "message": "<FeatureBlock> doesn't accept that prop. Declared props: icon, title, description, tag, variant, layout, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureBlock'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|brand|dark|minimal|bordered)$/]",
        "message": "<FeatureBlock> variant must be one of 'default' | 'brand' | 'dark' | 'minimal' | 'bordered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureBlock'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:card|inline)$/]",
        "message": "<FeatureBlock> layout must be one of 'card' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|basePath|alt|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, basePath, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|description|tag|icon|active|done|key|ref|className|style|children)$/]",
        "message": "<ProcessStep> doesn't accept that prop. Declared props: number, title, description, tag, icon, active, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectorTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:sector|icon|variant|key|ref|className|style|children)$/]",
        "message": "<SectorTag> doesn't accept that prop. Declared props: sector, icon, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectorTag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|outline|dark|neutral)$/]",
        "message": "<SectorTag> variant must be one of 'default' | 'outline' | 'dark' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|description|trend|compact|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, description, trend, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:up|down|neutral)$/]",
        "message": "<StatBlock> trend must be one of 'up' | 'down' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|role|company|sector|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, author, role, company, sector."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|date|tag|active|done|key|ref|className|style|children)$/]",
        "message": "<TimelineItem> doesn't accept that prop. Declared props: title, description, date, tag, active, done."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
